{
  "expo": {
    "name": "GlucoDose",
    "slug": "glucodose",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "glucodose",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.forth.glucodose"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#208AEF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.forth.glucodose",
      "versionCode": 10700,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'app utilise tes photos pour illustrer tes récipients.",
          "cameraPermission": "L'app utilise l'appareil photo pour prendre en photo tes récipients."
        }
      ],
      "expo-sharing",
      "expo-quick-actions",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "WeighWidget",
              "label": "Peser (GlucoDose)",
              "description": "Raccourci vers l'écran de pesée.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "L'app utilise le micro pour la recherche vocale d'aliment.",
          "speechRecognitionPermission": "L'app utilise la reconnaissance vocale pour la recherche d'aliment."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
