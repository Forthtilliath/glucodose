{
  "expo": {
    "name": "GlucoDose",
    "slug": "glucodose",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "glucodose",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.forth.glucodose"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#208AEF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.forth.glucodose"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'app utilise tes photos pour illustrer tes récipients.",
          "cameraPermission": "L'app utilise l'appareil photo pour prendre en photo tes récipients.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-quick-actions"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
